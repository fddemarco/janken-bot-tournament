# Google sign-in for the dashboard.
#
# Copy to `.streamlit/secrets.toml` (git-ignored) and fill in the three values
# from the Google Cloud Console OAuth client — see "Sign-in (SSO)" in README.md.
# Delete the file to run the dashboard without sign-in; it will say so loudly.

[auth]
# Your app's URL with the /oauth2callback path. Must match an "Authorized
# redirect URI" on the OAuth client *exactly*. Localhost may use http; any other
# host must use https — Google rejects plain http and raw IPs everywhere else.
redirect_uri = "http://localhost:8501/oauth2callback"
# On a server it's that deployment's own public URL instead, e.g.
# redirect_uri = "https://<your-host>/oauth2callback"

# Signs the identity cookie. Generate a fresh one, keep it out of git:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "CHANGE-ME"

[auth.google]
client_id = "xxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# `hd` pre-selects the Mutt Data Workspace on Google's account chooser. It is a
# convenience only — a user can ignore it and offer a personal account, which is
# why janken/auth.py re-checks the email domain on the returned token. It has to
# go in authorize_params: client_kwargs configures the OAuth session and only
# forwards keys Authlib knows (prompt, scope), so `hd` would be dropped there.
authorize_params = { hd = "muttdata.ai" }
client_kwargs = { prompt = "select_account" }
